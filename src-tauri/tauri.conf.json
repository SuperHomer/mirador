{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirador",
  "mainBinaryName": "mirador",
  "version": "0.1.3",
  "identifier": "com.yoanmarti.mirador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mirador",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "\u00a9 2026 Yoan Marti",
    "shortDescription": "A terminal built for watching over AI coding agents",
    "longDescription": "Mirador is a cross-platform terminal for AI coding agent workflows: vertical tab sidebar with git/PR/port context, agent attention notifications, visible interruptible command panes, a scriptable browser pane, SSH remote workspaces, and full CLI automation via `mira`.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mira"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
